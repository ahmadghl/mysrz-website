[Unit]
Description=SRZ Crawl Backend
Documentation=https://srz-crawl.com
After=network.target redis.service
Wants=redis.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/srz-crawl
EnvironmentFile=/opt/srz-crawl/.env
Environment="PATH=/opt/srz-crawl/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/opt/srz-crawl/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 3001 --workers 1
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10
StandardOutput=append:/opt/srz-crawl/logs/service.log
StandardError=append:/opt/srz-crawl/logs/error.log
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
