# ─────────────────────────────────────────────────────────────
# Frontend environment variables
#
# LOCAL DEV: copy this to .env.local and fill in values
# VERCEL:    set these in Vercel Dashboard → Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# Your VPS backend URL (no trailing slash)
# Example: https://api.yourdomain.com  OR  http://72.61.1.1:8000
VITE_API_URL=https://api.yourdomain.com
