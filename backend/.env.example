# ─────────────────────────────────────────────────────────────
# Backend environment variables
# Copy to backend/.env on your VPS and fill in values
# ─────────────────────────────────────────────────────────────

# App
APP_NAME=WebCrawler
APP_ENV=production
SECRET_KEY=change-this-to-a-random-64-char-string-minimum
DEBUG=false

# API
API_HOST=0.0.0.0
API_PORT=8000

# CORS — add your Vercel URL here (and any custom domain)
# Format: JSON array of allowed origins
CORS_ORIGINS=["https://your-app.vercel.app","https://crawler.yourdomain.com","http://localhost:3001"]

# Redis (internal Docker network — do not expose externally)
REDIS_URL=redis://crawler_redis:6379/0

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Celery
CELERY_BROKER_URL=redis://crawler_redis:6379/0
CELERY_RESULT_BACKEND=redis://crawler_redis:6379/1

# Crawler settings
MAX_CONCURRENT_CRAWLS=5
DEFAULT_CRAWL_DELAY=1.0
MAX_PAGES_PER_DOMAIN=10000
REQUEST_TIMEOUT=30
MAX_RETRIES=3
USER_AGENT=WebCrawlerBot/1.0 (+https://yourdomain.com/bot)

# Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# Flower (Celery monitoring) — basic auth for security
FLOWER_BASIC_AUTH=admin:changeme

# OpenAI (for embeddings + RAG chat)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o
