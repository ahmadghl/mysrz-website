# ── Supabase (server-side, used by Server Components + sitemap) ─────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Use the SERVICE ROLE key in your n8n workflow (NOT the anon key)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Revalidate webhook secret ───────────────────────────────────────────────
# Generate any random string. Use it in a Supabase Database Webhook
# (Database → Webhooks) pointing at:
#   POST https://www.mysrztourism.com/api/revalidate?secret=YOUR_SECRET
# This makes new/edited posts appear on the site immediately.
REVALIDATE_SECRET=replace-with-a-long-random-string

# ── Analytics tracker webhook (optional — remove to disable tracking) ───────
# Public env vars must be prefixed with NEXT_PUBLIC_ to reach the browser.
NEXT_PUBLIC_TRACKER_WEBHOOK_URL=https://n8n.mysrztourism.com/webhook/analytics
