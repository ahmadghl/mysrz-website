# ── Supabase ────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
#
# Public values are inlined into the browser bundle and must be prefixed
# with NEXT_PUBLIC_. The service-role key MUST NEVER be public.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Site identity ───────────────────────────────────────────────────────────
# Used as the canonical origin for OG URLs, sitemap, n8n callbacks, etc.
# Defaults to https://www.mysrztourism.com in production; override per env
# (preview deploys, local dev).
NEXT_PUBLIC_SITE_URL=https://www.mysrztourism.com

# ── Revalidate webhook ──────────────────────────────────────────────────────
# Generate any long random string. Use it in a Supabase Database Webhook
# (Database → Webhooks) pointing at:
#   POST https://www.mysrztourism.com/api/revalidate
# with the secret in either header:
#   Authorization: Bearer <REVALIDATE_SECRET>
#   x-webhook-secret: <REVALIDATE_SECRET>
# Query-string secrets are NOT accepted (they leak into proxy logs).
REVALIDATE_SECRET=replace-with-a-long-random-string

# ── n8n post-publish webhook (optional) ─────────────────────────────────────
# Fired by admin actions when a post is published. Signed with HMAC-SHA256
# using N8N_WEBHOOK_SECRET if set.
# N8N_PUBLISH_WEBHOOK_URL=https://n8n.mysrztourism.com/webhook/post-published
# N8N_WEBHOOK_SECRET=replace-with-a-long-random-string

# ── Analytics tracking ──────────────────────────────────────────────────────
# Tracking is first-party: the Tracker component posts to the same-origin
# /api/track route, which writes events into Supabase page_analytics using the
# anon key above (no extra config needed). The old n8n webhook var
# (NEXT_PUBLIC_TRACKER_WEBHOOK_URL) is no longer used.
#
# Optional: set NEXT_PUBLIC_GA_ID (e.g. G-XXXXXXXXXX) to also enable GA4.
# NEXT_PUBLIC_GA_ID=
